# Copy to .env and fill in real values.

# ---- Database ----
DATABASE_URL="postgresql://kanban:kanban@localhost:5432/kanban?schema=public"

# ---- Auth ----
# openssl rand -base64 48
SESSION_SECRET="change-me"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional: absolute path for uploaded files (defaults to ./uploads)
UPLOAD_DIR=""

# ---- Telegram (optional) ----
# From @BotFather. Empty => Telegram disabled, local dev-login enabled.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Reverse-proxy base for the Telegram API (for networks where api.telegram.org
# is blocked, e.g. RU). Empty = direct. Example: https://tg.example.com
TELEGRAM_API_ROOT=""

# ---- Admin ----
# Secret to self-promote the logged-in user to ADMIN at /admin.
ADMIN_SECRET="change-me"
# Owner's Telegram @username (without @): auto-ADMIN on first Telegram login.
ADMIN_TELEGRAM_USERNAME=""
# Secret Telegram sends with each webhook call (production).
TELEGRAM_WEBHOOK_SECRET=""

# ---- File storage (S3 / MinIO) ----
# Empty = local disk. Set all for S3-compatible storage (MinIO on the mini-PC).
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# --- iiko (вкладка «Статистика») — iikoServer/OLAP API ---
IIKO_BASE_URL=https://<your-iiko-host>          # без /resto
IIKO_LOGIN=apiuser
IIKO_PASS_SHA1=<sha1 пароля в hex>
IIKO_ORDER_TYPE_MAP={"Обычный заказ":"hall","Доставка курьером":"delivery","Самовывоз":"pickup"}
IIKO_JURPERSON_FILTER=                            # юрлицо для «Импорт из iiko» (напр. ФРЕШ ДВ); пусто = вводить вручную

# --- Genspark входящий вебхук (POST /api/webhooks/genspark) ---
GENSPARK_WEBHOOK_SECRET=                          # общий секрет; пусто = эндпоинт выключен (503)
GENSPARK_DEFAULT_BOARD_ID=                        # необязательно: доска по умолчанию для входящих задач
