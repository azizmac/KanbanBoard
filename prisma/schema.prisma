// Kanban Tracker — data model
// Prisma 7: generator `prisma-client`, datasource url comes from prisma.config.ts

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----- Users & access -----

enum Role {
  ADMIN // full control, manages users
  MANAGER // manages tasks & sees team
  MEMBER // regular team member
}

model User {
  id         String  @id @default(cuid())
  // Telegram identity (primary login method)
  telegramId String? @unique
  username   String? @unique // @handle used for mentions & login
  name       String
  avatarUrl  String?
  phone      String? // shared by the user via the bot (request_contact)
  role       Role    @default(MEMBER)
  position   String? // job title / должность (e.g. "Backend Lead")

  // optional reporting hierarchy ("кто кому подчиняется")
  managerId String?
  manager   User?   @relation("Reports", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]  @relation("Reports")

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // relations
  createdTasks  Task[]         @relation("TaskCreator")
  assignedTasks Task[]         @relation("TaskAssignee")
  comments      Comment[]
  attachments   Attachment[]
  mentions      Mention[]
  sessions      Session[]
  notifications Notification[]
  activities    Activity[]
  pushSubscriptions PushSubscription[]
  templatesCreated    TaskTemplate[] @relation("TemplateCreator")
  templateAssignments TaskTemplate[] @relation("TemplateAssignee")

  // org hierarchy: regions a (regional) manager runs + groups the user belongs to
  managedRegions Region[] @relation("RegionManagers")
  groups         Group[]  @relation("GroupMembers")
  ownedBoards    Board[]  @relation("OwnedBoards")

  @@index([managerId])
}

// ----- Org hierarchy: regions + access groups -----
//
// Role tiers (Role enum, relabeled in the UI — see lib/access.ts):
//   ADMIN   = Директор  — sees ALL boards, creates regions, assigns managers
//   MANAGER = Регионал   — runs assigned region(s): creates boards + groups there,
//             invites linear staff into groups
//   MEMBER  = Линейный   — sees only boards whose attached groups include them
//
// Board access = director (all) OR regional of the board's region OR member of any
// group attached to the board.

model Region {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("iris")
  createdAt DateTime @default(now())
  boards    Board[]
  groups    Group[]
  managers  User[]   @relation("RegionManagers")
}

// Справочник должностей — admin-managed list of job titles. A user's `position`
// string is set from this list.
model Position {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Group {
  id        String   @id @default(cuid())
  name      String
  regionId  String?
  region    Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  members   User[]   @relation("GroupMembers")
  boards    Board[]  @relation("BoardGroups")

  @@index([regionId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ----- Board structure -----

model Board {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("iris") // tint key for the board badge (see lib/tints)
  createdAt DateTime @default(now())
  columns   Column[]
  tags      Tag[]
  templates TaskTemplate[]

  // org: the region this board lives in, and the access groups attached to it
  regionId String?
  region   Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)
  groups   Group[] @relation("BoardGroups")

  // personal boards: a self-signup member owns the boards they create
  ownerId String?
  owner   User?   @relation("OwnedBoards", fields: [ownerId], references: [id], onDelete: SetNull)

  // a Telegram group chat linked to this board (for /tasks digests)
  telegramChatId String? @unique

  @@index([regionId])
}

model Column {
  id       String @id @default(cuid())
  name     String
  position Int // order of the column on the board
  boardId  String
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@index([boardId])
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  position    Int // order within its column
  priority    Priority  @default(NORMAL)
  dueDate     DateTime?

  columnId String
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id])

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments    Comment[]
  attachments Attachment[]
  mentions    Mention[]
  tags        Tag[]
  checklist   ChecklistItem[]
  activities  Activity[]

  @@index([columnId])
  @@index([assigneeId])
}

// GitLab-style task history (system notes): who changed what, when.
enum ActivityKind {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  UNASSIGNED
  PRIORITY_CHANGED
  DUE_CHANGED
  DUE_CLEARED
  TITLE_CHANGED
  DESCRIPTION_CHANGED
  TAG_ADDED
  TAG_REMOVED
  ATTACHMENT_ADDED
}

model Activity {
  id        String       @id @default(cuid())
  taskId    String
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User         @relation(fields: [actorId], references: [id])
  kind      ActivityKind
  detail    String? // pre-rendered detail, e.g. "В работе → Готово"
  createdAt DateTime     @default(now())

  @@index([taskId])
}

// Coloured label attached to tasks; scoped to a board.
model Tag {
  id      String @id @default(cuid())
  name    String
  color   String @default("gray") // tint key (see lib/tints)
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([boardId])
}

// A single checklist row inside a task.
model ChecklistItem {
  id       String  @id @default(cuid())
  text     String
  done     Boolean @default(false)
  position Int
  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Comment {
  id        String    @id @default(cuid())
  body      String
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  createdAt DateTime  @default(now())
  mentions  Mention[]

  @@index([taskId])
}

model Attachment {
  id         String   @id @default(cuid())
  filename   String // original file name
  storedName String // name on disk / storage key
  mimeType   String
  size       Int
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  createdAt  DateTime @default(now())

  @@index([taskId])
}

// A user mentioned inside a task description or a comment
model Mention {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum NotificationType {
  ASSIGNED
  MENTIONED
  COMMENTED
  DUE_SOON
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  taskId    String?
  read      Boolean          @default(false)
  // whether it was pushed to Telegram
  delivered Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

// ----- Web Push (PWA) -----

// A browser/device push subscription (one per installed PWA / browser).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Singleton holding the server's VAPID keypair (generated on first use, so web
// push needs zero env config). Always id = "default".
model PushConfig {
  id         String   @id @default("default")
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())
}

// ----- Task templates + recurrence -----

// A reusable task blueprint. With a recurrence set, the bot creates a task from
// it on schedule; without one, it's just a quick-create template.
model TaskTemplate {
  id          String   @id @default(cuid())
  name        String // template name, e.g. "Еженедельный отчёт"
  title       String // title of the task it creates
  description String?
  priority    Priority @default(NORMAL)

  boardId    String
  board      Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  columnId   String? // null = board's first column
  assigneeId String?
  assignee   User?   @relation("TemplateAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  checklist String[] // checklist item texts
  tags      String[] // tag names
  dueInDays Int? // if set, created task gets dueDate = now + N days

  // recurrence — null means "manual template only"
  recurrence  String? // "daily" | "weekly" | "monthly"
  weekday     Int? // 1-7 (Mon..Sun) for weekly
  monthday    Int? // 1-31 for monthly
  hour        Int     @default(9)
  active      Boolean @default(true)
  lastRunDate String? // "YYYY-MM-DD" of last auto-creation (dedup)

  creatorId String
  creator   User     @relation("TemplateCreator", fields: [creatorId], references: [id])
  createdAt DateTime @default(now())

  @@index([boardId])
}

// One-time nonce for "login via bot deep-link" — the RU-friendly sign-in that
// doesn't depend on telegram.org (the official widget is blocked there). The
// browser creates a row, opens t.me/<bot>?start=login_<nonce>; the bot resolves
// the Telegram user and flips status to "ready"; the browser polls and the
// status endpoint then mints the session. Short-lived + single-use.
model LoginNonce {
  id          String   @id @default(cuid())
  nonce       String   @unique
  inviteToken String? // carried from the kanban_invite cookie so role/group survive
  userId      String? // set by the bot once the Telegram user is resolved
  status      String   @default("pending") // pending | ready | used | denied
  error       String? // "disabled" | "notlinked" when denied
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}
