# Copy to deploy/.env.prod and fill in. Never commit the real file.

# ---- public address (Caddy domain) ----
APP_DOMAIN=kanban.freshdv.ru
NEXT_PUBLIC_APP_URL=https://kanban.freshdv.ru

# ---- Postgres (the compose 'db' service) ----
POSTGRES_USER=kanban
POSTGRES_PASSWORD=CHANGE_ME_long_random
POSTGRES_DB=kanban
# app/bot/migrate reach Postgres by the compose service name 'db':
DATABASE_URL=postgresql://kanban:CHANGE_ME_long_random@db:5432/kanban?schema=public

# ---- MinIO (S3) — the compose 'minio' service ----
MINIO_ROOT_USER=kanban
MINIO_ROOT_PASSWORD=CHANGE_ME_long_random
S3_BUCKET=kanban
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=kanban
S3_SECRET_KEY=CHANGE_ME_long_random

# ---- auth/session secrets ----
SESSION_SECRET=CHANGE_ME_64_hex
ADMIN_SECRET=CHANGE_ME_secret_phrase
# First Telegram login with this @username is bootstrapped as ADMIN:
ADMIN_TELEGRAM_USERNAME=your_telegram_handle
# Onboarding: invite links (admin panel → "Ссылка-приглашение") always work.
# Set OPEN_SIGNUP=true to additionally let ANY Telegram login self-register as
# MEMBER without a link (open access — use with care). Default: off.
OPEN_SIGNUP=false

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=0000000000:AA...your-bot-token
TELEGRAM_BOT_USERNAME=taskmanagerpims_bot
TELEGRAM_WEBHOOK_SECRET=unused_with_long_polling_but_keep_set
# THE BYPASS: route all Bot API calls through your Cloudflare relay.
# Empty = talk to api.telegram.org directly (only works if the box can reach it,
# e.g. via GoodbyeDPI/Zapret).
TELEGRAM_API_ROOT=https://tg-relay.YOURNAME.workers.dev
